---
import "@fontsource-variable/fraunces/soft.css";
import "@fontsource-variable/figtree";
import "@fontsource-variable/jetbrains-mono";
import ArquivosAnvisa from "../components/ArquivosAnvisa.astro";
import Corredores from "../components/Corredores.astro";
import Logo from "../components/Logo.astro";
import { arquivosDaTabela } from "../lib/arquivos";
import { MANIFEST_URL, REPO } from "../lib/config";
import { TABELA_MEDIDAS } from "../lib/consultas";
import { CORREDOR_PADRAO, CORREDORES } from "../corredores";
import { url } from "../lib/format";
import { manifestDoBuild } from "../lib/manifest";
import { DESCRICAO, NOME, tituloPagina } from "../lib/marca";
import { relatoHtml } from "../lib/relato";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** corredor desta página (busca); dados e sobre não têm */
  corredor?: string;
  /** fora dos buscadores (a página de erro) */
  noindex?: boolean;
  /** a página inicial: fundo próprio (inicio.css), para os cartões dos corredores não sumirem nele */
  inicio?: boolean;
  /** JSON-LD (schema.org) que descreve o que a página mostra */
  estruturados?: Record<string, unknown>[];
  /** parágrafos em largura de leitura (main.prosa p, em componentes.css): as páginas de empresa e de fabricante */
  prosa?: boolean;
}
const {
  title,
  corredor,
  description = DESCRICAO,
  noindex = false,
  inicio = false,
  estruturados = [],
  prosa = false,
} = Astro.props;
const titulo = tituloPagina(title);
// endereço canônico: o da página sem query (?q=, ?p= são estado da busca, não páginas)
const canonico = new URL(Astro.url.pathname, Astro.site).href;
// JSON dentro de <script>: "</" não pode aparecer cru
const jsonLd = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, "\\u003c");
// "Encontrou um erro?" in the footer: the report links carry this page's address (no item: the footer is not about one)
// The 404 is served for any missing path, so its own address says nothing: the reader fills the page in.
const relato = relatoHtml({ pagina: Astro.url.pathname.startsWith("/404") ? "" : canonico, titulo: title }, true);

// Footer with ANVISA's files for every corridor in this build (switching corridors does not reload the page, so
// the footer names them all); derived tables resolve to the raw files.
const tabelas = (await manifestDoBuild(MANIFEST_URL)).tables;
const origens = [
  ...CORREDORES.map((c) => ({ nome: c.curto, tabela: c.tabela })),
  // as medidas de fiscalização aparecem em todo corredor
  { nome: "Medidas", tabela: TABELA_MEDIDAS },
].flatMap(({ nome, tabela }) => {
  const arquivos = arquivosDaTabela(tabelas, tabela);
  return arquivos.length ? [{ nome, arquivos }] : [];
});
const atual = Astro.url.pathname.replace(/\/+$/, "/");
const ativo = (p: string) => (atual === url(p) ? "page" : undefined);
// para o script inline marcar o corredor pela URL antes da primeira pintura
const slugs = CORREDORES.map((c) => [c.slug, c.id]);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<!-- o corredor já vem no HTML (o script inline só confirma pela URL): sem JavaScript, a abertura certa aparece -->
<html lang="pt-BR" data-corredor={corredor ?? CORREDOR_PADRAO.id} data-pagina={inicio ? "inicio" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonico} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${NOME}.`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonico} />}
    <meta name="twitter:card" content="summary" />
    {estruturados.map((d) => (
      <script type="application/ld+json" set:html={jsonLd(d)} />
    ))}
    <meta name="theme-color" content={inicio ? "#dfe2e6" : "#f6f1e6"} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    {/* Os comentários deste script ficam aqui fora, porque um script inline vai como está para cada página.
         Ele marca corredor e tela pela URL antes da primeira pintura (por isso inline): a página já abre com
         as cores do corredor e, em link de busca ou produto, sem a abertura piscando. Com JavaScript a ilha
         vai montar, então data-ilha="carregando" faz o texto abaixo dela esperar (senão a ilha, ao crescer, o
         empurra: deslocamento de layout); sem JavaScript o atributo não existe e o texto aparece de cara. */}
    <script is:inline define:vars={{ slugs, base }}>
      const h = document.documentElement;
      const resto = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
      const seg = resto.split("/").filter(Boolean)[0] || "";
      h.dataset.corredor = (slugs.find(([s]) => s === seg) || slugs[0])[1];
      const q = new URLSearchParams(location.search);
      h.dataset.tela = q.has("p") ? "produto" : ["q", "marca", "cat"].some((k) => q.has(k)) ? "busca" : "inicio";
      h.dataset.ilha = "carregando";
    </script>
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site">
      <div class="inner">
        <Logo />
        <Corredores atual={corredor} />
        <nav class="nav-site" aria-label="Sobre o site">
          <a href={url("/empresas/")} aria-current={ativo("/empresas/")}>
            Empresas
          </a>
          <a href={url("/dicionario/")} aria-current={ativo("/dicionario/")}>
            Dados
          </a>
          <a href={url("/sobre/")} aria-current={ativo("/sobre/")}>
            Sobre
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo" class:list={{ "com-busca": corredor, prosa }}>
      <slot />
    </main>
    <footer class="site">
      <div class="rotulo-rodape">
        <dl>
          <div>
            <dt>Fonte</dt>
            <dd>
              Dados abertos da ANVISA.
              {origens.map(({ nome, arquivos }, i) => (
                <>
                  {/* Astro drops the line break after "ANVISA." */ i > 0 ? " · " : " "}
                  {nome}: <ArquivosAnvisa arquivos={arquivos} />
                </>
              ))}
            </dd>
          </div>
          <div>
            <dt>Atenção</dt>
            <dd>Sem vínculo com a ANVISA. Confira sempre a consulta oficial.</dd>
          </div>
          <div>
            <dt>Contato</dt>
            <dd>
              <Fragment set:html={relato} /> <a href={REPO}>Código do site</a>
            </dd>
          </div>
        </dl>
      </div>
    </footer>
  </body>
</html>
