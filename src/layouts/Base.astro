---
import "@fontsource-variable/fraunces/soft.css";
import "@fontsource-variable/figtree";
import "@fontsource-variable/jetbrains-mono";
import Corredores from "../components/Corredores.astro";
import Icone from "../components/Icone.astro";
import Logo from "../components/Logo.astro";
import { MANIFEST_URL } from "../lib/config";
import { CORREDOR_PADRAO, CORREDORES } from "../corredores";
import { fmtData, url } from "../lib/format";
import { manifestDoBuild } from "../lib/manifest";
import { DESCRICAO, NOME, SLOGAN, tituloPagina } from "../lib/marca";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** corredor desta página (busca); dados e sobre não têm */
  corredor?: string;
  /** fora dos buscadores (a página de erro) */
  noindex?: boolean;
  /** JSON-LD (schema.org) que descreve o que a página mostra */
  estruturados?: Record<string, unknown>[];
}
const { title, corredor, description = DESCRICAO, noindex = false, estruturados = [] } = Astro.props;
const titulo = tituloPagina(title);
// endereço canônico: o da página sem query (?q=, ?p= são estado da busca, não páginas)
const canonico = new URL(Astro.url.pathname, Astro.site).href;
// JSON dentro de <script>: "</" não pode aparecer cru
const jsonLd = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, "\\u003c");

// rodapé com a origem de cada corredor no último build (a troca de corredor não recarrega a página, então
// o rodapé cita todos); a busca mostra a do corredor ativo pelo manifest ao vivo
const tabelas = (await manifestDoBuild(MANIFEST_URL)).tables;
const medidas = tabelas.produtos_irregulares?.source;
const origens = [
  ...CORREDORES.flatMap((c) => {
    const origem = tabelas[c.tabela]?.source;
    return origem ? [{ nome: c.curto, origem }] : [];
  }),
  // as medidas de fiscalização aparecem em todo corredor
  ...(medidas ? [{ nome: "Medidas", origem: medidas }] : []),
];
// o que é de um corredor só (o ícone do rodapé) aparece só nele, também depois de trocar sem recarregar
const soCorredor = `[data-so-corredor]{display:none}${CORREDORES.map(
  (c) => `[data-corredor="${c.id}"] [data-so-corredor="${c.id}"]{display:inline}`,
).join("")}`;
const atual = Astro.url.pathname.replace(/\/+$/, "/");
const ativo = (p: string) => (atual === url(p) ? "page" : undefined);
// para o script inline marcar o corredor pela URL antes da primeira pintura
const slugs = CORREDORES.map((c) => [c.slug, c.id]);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<!-- o corredor já vem no HTML (o script inline só confirma pela URL): sem JavaScript, a abertura certa aparece -->
<html lang="pt-BR" data-corredor={corredor ?? CORREDOR_PADRAO.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonico} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${NOME}.`} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonico} />}
    <meta name="twitter:card" content="summary" />
    {estruturados.map((d) => (
      <script type="application/ld+json" set:html={jsonLd(d)} />
    ))}
    <meta name="theme-color" content="#f6f1e6" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <script is:inline define:vars={{ slugs, base }}>
      // marca corredor e tela pela URL antes da primeira pintura (por isso inline): a página já abre com
      // as cores do corredor e, em link de busca ou produto, sem a abertura piscando
      const h = document.documentElement;
      const resto = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
      const seg = resto.split("/").filter(Boolean)[0] || "";
      h.dataset.corredor = (slugs.find(([s]) => s === seg) || slugs[0])[1];
      const q = new URLSearchParams(location.search);
      h.dataset.tela = q.has("p") ? "produto" : ["q", "marca", "cat"].some((k) => q.has(k)) ? "busca" : "inicio";
    </script>
    <style is:inline set:html={soCorredor}></style>
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site">
      <div class="inner">
        <Logo />
        <Corredores atual={corredor} />
        <nav class="nav-site" aria-label="Sobre o site">
          <a href={url("/dicionario/")} aria-current={ativo("/dicionario/")}>
            Dados
          </a>
          <a href={url("/sobre/")} aria-current={ativo("/sobre/")}>
            Sobre
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <div class="rotulo-rodape">
        <p class="rotulo-titulo">
          <Logo /> <span>{SLOGAN}</span>
        </p>
        <dl>
          <div>
            <dt>Fonte</dt>
            <dd>
              Dados abertos da ANVISA:
              {origens.map(({ nome, origem }, i) => (
                <>
                  {/* o Astro descarta a quebra de linha depois de "ANVISA:" */ i > 0 ? " · " : " "}
                  {nome}
                  {origem.loaded_at && <> de {fmtData(origem.loaded_at)}</>} (<a href={origem.url}>{origem.name}</a>)
                </>
              ))}
            </dd>
          </div>
          <div>
            <dt>Atenção</dt>
            <dd>Ferramenta independente, sem vínculo com a ANVISA. Confira sempre a consulta oficial.</dd>
          </div>
          <div>
            <dt>Contém</dt>
            <dd>
              Nenhum servidor: a busca roda inteira no seu navegador.
              {CORREDORES.map((c) => (
                <span data-so-corredor={c.id}>
                  <Icone nome={c.icone} class="mini" />
                </span>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </footer>
  </body>
</html>
