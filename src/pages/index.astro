---
// A página inicial: os cinco corredores, um por faixa em tela larga (prateleiras: nome à esquerda, o que há
// no meio, busca à direita) e empilhados no celular, cada um com as próprias cores (os tokens de
// [data-corredor] valem em qualquer elemento), os totais do build e uma busca que é um formulário GET de
// verdade: funciona sem JavaScript e abre o corredor com ?q=. Sem a ilha: a busca roda na página do corredor.
import Base from "../layouts/Base.astro";
import Icone from "../components/Icone.astro";
import { CORREDORES, rotaDo } from "../corredores";
import { totaisDoBuild } from "../lib/estatico/dados";
import { fmtInt, url } from "../lib/format";
import { DESCRICAO, NOME } from "../lib/marca";

const totais = await totaisDoBuild();
// o site em si (schema.org WebSite), só aqui
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${NOME}.`,
  url: new URL(url("/"), Astro.site).href,
  inLanguage: "pt-BR",
  description: DESCRICAO,
};
---

<Base title="Produtos liberados pela ANVISA" description={DESCRICAO} estruturados={[site]} inicio>
  <h1>Está liberado pela ANVISA?</h1>

  <div class="secoes">
    {CORREDORES.map((c) => {
      const n = totais[c.id];
      return (
        <section class="secao-inicial" data-corredor={c.id} aria-labelledby={`sec-${c.id}`}>
          <h2 id={`sec-${c.id}`}>
            <span class="num" aria-hidden="true">
              {c.numero}
            </span>
            <Icone nome={c.icone} />
            <a href={rotaDo(c)}>{c.nome}</a>
          </h2>
          <div class="texto">
            <p class="desc">{c.lead}</p>
            {n && (
              <p class="totais">
                <strong>{fmtInt(n.ativos)}</strong> liberados · {fmtInt(n.empresas)} empresas
              </p>
            )}
          </div>
          <form class="busca" role="search" action={rotaDo(c)} method="get">
            <div class="busca-campo">
              <label for={`q-${c.id}`} class="sr-only">
                Buscar em {c.nome}
              </label>
              <Icone nome="lupa" />
              <input
                id={`q-${c.id}`}
                class="field"
                type="search"
                name="q"
                autocomplete="off"
                enterkeyhint="search"
                placeholder={c.placeholder}
              />
            </div>
            <button class="btn primary" type="submit" aria-label={`Buscar em ${c.nome}`}>
              <Icone nome="seta" />
            </button>
          </form>
          <p class="note">
            Experimente:{" "}
            {c.exemplos.slice(0, 2).map((x, i) => (
              <>
                {i > 0 && ", "}
                <a href={`${rotaDo(c)}?${new URLSearchParams({ q: x.valor }).toString()}`}>{x.texto}</a>
              </>
            ))}
          </p>
        </section>
      );
    })}
  </div>

  <section class="texto-corredor">
    <h2>“Está liberado?” quer dizer o quê</h2>
    <p>
      Que a ANVISA tem esse produto no cadastro dela, em nome de uma empresa com CNPJ, e que o cadastro está em vigor. É
      isso que a busca responde. Ela não diz se o produto é bom, nem se funciona: diz se a empresa fez a parte
      burocrática e se a ANVISA não mandou tirar da prateleira.
    </p>
    <p>
      Dois caminhos levam ao cadastro. No registro, a ANVISA analisa antes e dá um número. Na notificação, a empresa
      comunica o produto e assume o que declarou. Para quem compra, dá no mesmo: os dois aparecem aqui como liberados.
    </p>
    <h2>O número do rótulo</h2>
    <p>
      Procure no verso da embalagem algo como “25351.453332/2024-10” ou “Produto notificado na ANVISA nº...”. É o
      processo. Cole ele na busca, com ou sem pontos. Nem todo rótulo traz o número, e os antigos vêm com 13 dígitos em
      vez de 17: a busca entende os dois.
    </p>
    <p>Sem número, a marca costuma bastar. Sem marca, o CNPJ do fabricante ou do importador, que sempre está lá.</p>
  </section>

  <p class="note">
    Também: <a href={url("/empresas/")}>empresas de A a Z</a> · <a href={url("/dicionario/")}>dicionário de dados</a> ·{" "}
    <a href={url("/sobre/")}>sobre o site</a>
  </p>
</Base>

<style>
  /* a home fala com a letra de texto (Figtree), mais leve que a Fraunces em 700 dos corredores; os cartões
     seguem com a letra do próprio corredor */
  h1,
  .texto-corredor h2 {
    font-family: var(--fonte-texto);
    font-variation-settings: normal;
    font-weight: 600;
  }
  /* título curto: os cartões são a página */
  h1 {
    font-size: clamp(1.5rem, 3.2vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.8rem 0 0;
  }
  /* uma faixa por corredor, empilhadas; em tela larga cada faixa é uma linha de três colunas (abaixo) */
  .secoes {
    display: grid;
    gap: 0.75rem;
    margin: 1.1rem 0 2.5rem;
  }
  /* cada faixa com o papel, a tinta e o fundo do seu corredor */
  .secao-inicial {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.1rem 1rem;
    color: var(--fg);
    background-color: var(--bg);
    background-image: var(--padrao);
    background-size: var(--padrao-tam);
    border: 2px solid var(--contorno);
    border-radius: var(--raio);
    box-shadow: var(--sombra-superficie);
  }
  .secao-inicial h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 1.25rem;
  }
  /* o número e o ícone não encolhem quando o nome quebra em duas linhas (Alimentos e suplementos) */
  .secao-inicial h2 > :not(a) {
    flex: none;
  }
  .secao-inicial h2 a {
    color: inherit;
    text-decoration: none;
  }
  .secao-inicial h2 a:hover {
    text-decoration: underline;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.95rem;
    font-family: var(--fonte-mono);
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .desc,
  .totais {
    margin: 0;
  }
  .totais {
    font-size: 0.95rem;
  }
  .totais strong {
    font-family: var(--fonte-titulo);
    font-size: 1.15rem;
  }
  .secao-inicial .busca {
    margin-top: auto;
  }
  .secao-inicial .busca .field {
    font-size: 1rem;
  }
  .secao-inicial .note {
    margin: 0;
  }
  /* tela larga: a faixa vira uma linha (prateleira). Nome, ícone e número à esquerda numa coluna fixa, a mesma
     em todas as faixas (cada faixa é uma grade própria), que cabe "Alimentos e suplementos" em uma linha (314 px
     medidos em 2026-10-22); descrição e totais no meio; busca e exemplos à direita */
  @media (min-width: 60rem) {
    .secao-inicial {
      display: grid;
      grid-template-columns: 19.5rem 1fr minmax(18rem, 1.1fr);
      grid-template-areas:
        "titulo texto busca"
        "titulo texto nota";
      align-items: center;
      column-gap: 1.25rem;
      row-gap: 0.35rem;
      padding: 0.9rem 1.1rem;
    }
    .secao-inicial h2 {
      grid-area: titulo;
      white-space: nowrap;
    }
    .texto {
      grid-area: texto;
    }
    .secao-inicial .busca {
      grid-area: busca;
      margin: 0;
    }
    .secao-inicial .note {
      grid-area: nota;
    }
  }
</style>
