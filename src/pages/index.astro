---
import BuscaApp from "../components/BuscaApp.vue";
import Icone from "../components/Icone.astro";
import Base from "../layouts/Base.astro";

// ícones que flutuam em volta do título: produtos de prateleira, de comida a limpeza
const DECO = ["capsula", "folha", "pote", "trigo", "borrifador", "leite", "bolhas", "colher", "gota"];
---

<Base title="O que tem no que você consome e usa">
  <!-- só aparece na tela inicial; a ilha marca a tela em body[data-tela] -->
  <section class="hero">
    <div class="hero-deco" aria-hidden="true">
      {DECO.map((nome, i) => <span class={`deco deco-${i}`}><Icone nome={nome} /></span>)}
      <svg class="carimbo" viewBox="0 0 120 120">
        <defs><path id="carimbo-circulo" d="M60 60m-45 0a45 45 0 1 1 90 0a45 45 0 1 1-90 0" /></defs>
        <circle cx="60" cy="60" r="56" class="carimbo-borda" />
        <!-- textLength fecha a volta exata no círculo (2π·45 ≈ 283) -->
        <text><textPath href="#carimbo-circulo" textLength="281" lengthAdjust="spacing">dados abertos · leia o rótulo ·</textPath></text>
        <g transform="rotate(-40 60 60)">
          <rect x="38" y="51" width="44" height="18" rx="9" class="carimbo-capsula-a" />
          <path d="M60 51h13a9 9 0 0 1 0 18H60Z" class="carimbo-capsula-b" />
        </g>
      </svg>
    </div>
    <p class="hero-selo"><Icone nome="lupa" /> leia o rótulo antes de levar</p>
    <h1>
      Este produto é <em>regular</em>?<br />O que ele{" "}
      <span class="sublinhado">contém<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c40-6 90-7 196-2" /></svg></span>?
    </h1>
    <p class="lead">
      Alimentos e suplementos regularizados na ANVISA, e em breve saneantes. Busque pela marca, pelo nome, pela
      empresa, pelo CNPJ ou pelo número do processo.
    </p>
  </section>
  <!-- DuckDB-WASM não roda no servidor: a ilha só existe no navegador -->
  <BuscaApp client:only="vue">
    <div slot="fallback" class="busca-esqueleto" aria-hidden="true"><span></span><span></span></div>
  </BuscaApp>
  <noscript><p class="estado erro">A busca precisa de JavaScript: ela roda inteira no seu navegador.</p></noscript>
</Base>
