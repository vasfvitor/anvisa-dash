---
// A página inicial: os três corredores lado a lado, cada um com as próprias cores (os tokens de
// [data-corredor] valem em qualquer elemento), os totais do build e uma busca que é um formulário GET de
// verdade: funciona sem JavaScript e abre o corredor com ?q=. Sem a ilha: a busca roda na página do corredor.
import Base from "../layouts/Base.astro";
import Icone from "../components/Icone.astro";
import { CORREDORES, rotaDo, type IdCorredor } from "../corredores";
import { totaisDoBuild } from "../lib/estatico/dados";
import { fmtInt, url } from "../lib/format";
import { DESCRICAO, NOME } from "../lib/marca";

const totais = await totaisDoBuild();
// o que tem em cada corredor, em vez do lead (igual nos três); medido em 2026-10-10: nos alimentos, 9.233 dos
// cerca de 10.300 liberados são suplementos, depois alimentos infantis e dietas enterais
const CONTEUDO: Record<IdCorredor, string> = {
  alimentos: "Suplementos, alimentos infantis e dietas enterais.",
  saneantes: "Água sanitária, detergente, desinfetante, inseticida.",
  cosmeticos: "Shampoo, protetor solar, maquiagem, perfume, fralda.",
};
// o site em si (schema.org WebSite), só aqui
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${NOME}.`,
  url: new URL(url("/"), Astro.site).href,
  inLanguage: "pt-BR",
  description: DESCRICAO,
};
---

<Base title="Produtos liberados pela ANVISA" description={DESCRICAO} estruturados={[site]}>
  <h1>Está liberado pela ANVISA?</h1>
  <p class="lead">
    Digite o nome, a marca, o CNPJ ou o número do processo que vem no rótulo. Os dados são os da própria ANVISA,
    atualizados nos dias úteis.
  </p>

  <div class="secoes">
    {CORREDORES.map((c) => {
      const n = totais[c.id];
      return (
        <section class="secao-inicial" data-corredor={c.id} aria-labelledby={`sec-${c.id}`}>
          <h2 id={`sec-${c.id}`}>
            <span class="num" aria-hidden="true">
              {c.numero}
            </span>
            <Icone nome={c.icone} />
            <a href={rotaDo(c)}>{c.nome}</a>
          </h2>
          <p class="desc">{CONTEUDO[c.id]}</p>
          {n && (
            <p class="totais">
              <strong>{fmtInt(n.ativos)}</strong> liberados · {fmtInt(n.empresas)} empresas
            </p>
          )}
          <form class="busca" role="search" action={rotaDo(c)} method="get">
            <div class="busca-campo">
              <label for={`q-${c.id}`} class="sr-only">
                Buscar em {c.nome}
              </label>
              <Icone nome="lupa" />
              <input
                id={`q-${c.id}`}
                class="field"
                type="search"
                name="q"
                autocomplete="off"
                enterkeyhint="search"
                placeholder="Nome ou CNPJ"
              />
            </div>
            <button class="btn primary" type="submit" aria-label={`Buscar em ${c.nome}`}>
              <Icone nome="seta" />
            </button>
          </form>
          <p class="note">
            Experimente:{" "}
            {c.exemplos.slice(0, 2).map((x, i) => (
              <>
                {i > 0 && ", "}
                <a href={`${rotaDo(c)}?${new URLSearchParams({ q: x.valor }).toString()}`}>{x.texto}</a>
              </>
            ))}
          </p>
        </section>
      );
    })}
  </div>

  <p class="note">
    Também: <a href={url("/empresas/")}>empresas de A a Z</a> · <a href={url("/dicionario/")}>dicionário de dados</a> ·{" "}
    <a href={url("/sobre/")}>sobre o site</a>
  </p>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 1.2rem 0 0;
  }
  .lead {
    color: var(--muted);
  }
  .secoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 2rem 0 2.5rem;
  }
  /* cada seção com o papel, a tinta e o fundo do seu corredor */
  .secao-inicial {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.1rem 1rem;
    color: var(--fg);
    background-color: var(--bg);
    background-image: var(--padrao);
    background-size: var(--padrao-tam);
    border: 2px solid var(--contorno);
    border-radius: var(--raio);
    box-shadow: var(--sombra-superficie);
  }
  .secao-inicial h2 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 1.35rem;
  }
  .secao-inicial h2 a {
    color: inherit;
    text-decoration: none;
  }
  .secao-inicial h2 a:hover {
    text-decoration: underline;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.95rem;
    font-family: var(--fonte-mono);
  }
  .desc,
  .totais {
    margin: 0;
  }
  .desc {
    color: var(--muted);
  }
  .totais strong {
    font-family: var(--fonte-titulo);
    font-size: 1.15rem;
  }
  .secao-inicial .busca {
    margin-top: auto;
  }
  .secao-inicial .busca .field {
    font-size: 1rem;
  }
  .secao-inicial .note {
    margin: 0;
  }
</style>
