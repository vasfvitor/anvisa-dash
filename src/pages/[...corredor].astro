---
import BuscaApp from "../components/BuscaApp.vue";
import Abertura from "../components/Abertura.astro";
import Base from "../layouts/Base.astro";
import { CORREDORES, type Corredor } from "../corredores";
import { url } from "../lib/format";
import { DESCRICAO, NOME } from "../lib/marca";

// uma página por corredor: / é alimentos, /limpeza/ é saneantes
export function getStaticPaths() {
  return CORREDORES.map((c) => ({ params: { corredor: c.slug || undefined }, props: { id: c.id } }));
}
const { id } = Astro.props;
const corredor = CORREDORES.find((c) => c.id === id) as Corredor;
// o site em si (schema.org WebSite), só na página da raiz
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${NOME}.`,
  url: new URL(url("/"), Astro.site).href,
  inLanguage: "pt-BR",
  description: DESCRICAO,
};
---

<Base
  title={corredor.titulo}
  description={corredor.descricao}
  corredor={corredor.id}
  estruturados={corredor.slug ? [] : [site]}
>
  <Abertura c={corredor} />
  {CORREDORES.map((c) => (
    <template data-hero={c.id}>
      <Abertura c={c} />
    </template>
  ))}
  <!-- DuckDB-WASM não roda no servidor: a ilha só existe no navegador -->
  <BuscaApp client:only="vue">
    <div slot="fallback" class="busca-esqueleto" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </BuscaApp>
  <noscript>
    <p class="estado erro">A busca precisa de JavaScript: ela roda inteira no seu navegador.</p>
  </noscript>
</Base>
