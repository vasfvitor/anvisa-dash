---
import Base from "../layouts/Base.astro";
import { TABELAS } from "../corredores";
import { MANIFEST_URL } from "../lib/config";
import { conjuntoDados } from "../lib/dataset";
import { fmtBytes, fmtData, fmtDataLocal, fmtInt } from "../lib/format";
import { manifestDoBuild, tabelaUrl } from "../lib/manifest";

// gerado a cada build a partir do manifest: tabela ou coluna nova aparece aqui sem mudar código, com o título,
// as notas e as descrições das colunas escritas no repo `anvisa` (desde o build 20261012T000746Z)
const m = await manifestDoBuild(MANIFEST_URL);
const tabelas = Object.entries(m.tables);
// o dicionário que o pipeline gera ao lado do manifest (a mesma informação, sem o site em volta)
const docs = m.docs ? new URL(m.docs, MANIFEST_URL).href : undefined;
const titulo = (nome: string) => TABELAS[nome]?.titulo ?? m.tables[nome]!.title;

// um Dataset (schema.org) por tabela que a página descreve, com o Parquet como distribuição
const pagina = new URL(Astro.url.pathname, Astro.site).href;
const conjuntos = tabelas.flatMap(([nome, t]) => {
  const info = TABELAS[nome];
  if (!info) return [];
  return [
    conjuntoDados(nome, t, info, {
      pagina,
      parquet: tabelaUrl(MANIFEST_URL, m, nome),
      atualizado: t.source.loaded_at ?? m.built_at,
    }),
  ];
});
---

<Base
  estruturados={conjuntos}
  title="Dicionário de dados"
  description="Tabelas e colunas dos dados abertos da ANVISA usados no site (alimentos, produtos de limpeza e cosméticos), em Parquet."
>
  <h1>Dicionário de dados</h1>
  <p class="lead">
    O site consulta arquivos Parquet republicados diariamente a partir dos dados abertos da ANVISA. Esta página descreve
    o build <code>{m.build_id}</code>, gerado em {fmtDataLocal(m.built_at)}.
  </p>
  <p class="note">
    Manifest: <a href={MANIFEST_URL}>{MANIFEST_URL}</a>. Os caminhos dos arquivos mudam a cada build; leia sempre o
    manifest primeiro.
    {docs && (
      <>
        {" "}
        O pipeline publica <a href={docs}>o mesmo dicionário</a> ao lado do manifest.
      </>
    )}
    {m.license && (
      <>
        {" "}
        Dados: {m.license.data}. Código do pipeline: licença {m.license.code}.
      </>
    )}
  </p>

  <nav class="badges" aria-label="Tabelas">
    {tabelas.map(([nome]) => (
      <a class="badge" href={`#${nome}`}>
        {nome}
      </a>
    ))}
  </nav>

  {tabelas.map(([nome, t]) => (
    <section id={nome}>
      <h2>
        {titulo(nome) ? (
          <>
            {titulo(nome)}{" "}
            <span class="sub">
              <code>{nome}</code> · {fmtInt(t.rows)} linhas · {fmtBytes(t.bytes)}
            </span>
          </>
        ) : (
          <>
            <code>{nome}</code>{" "}
            <span class="sub">
              {fmtInt(t.rows)} linhas · {fmtBytes(t.bytes)}
            </span>
          </>
        )}
      </h2>
      {TABELAS[nome] && <p>{TABELAS[nome].descricao}</p>}
      {t.notes?.length ? (
        <ul class="notas">
          {t.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      ) : null}
      <p class="note">
        {t.fontes?.length ? (
          <>
            Derivada de{" "}
            {t.fontes.map((f, i) => (
              <>
                {i > 0 && ", "}
                <a href={`#${f}`}>
                  <code>{f}</code>
                </a>
              </>
            ))}{" "}
            a cada build (<a href={t.source.url}>receita</a>)
          </>
        ) : (
          <>
            Origem: <a href={t.source.url}>{t.source.name}</a>
          </>
        )}
        {t.source.loaded_at && <>, dados de {fmtData(t.source.loaded_at)}</>}.
        {t.sort?.length ? (
          <>
            {" "}
            Ordenado por <code>{t.sort.join(", ")}</code>.
          </>
        ) : null}{" "}
        <a href={tabelaUrl(MANIFEST_URL, m, nome)}>Baixar Parquet</a>.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Coluna</th>
              <th>Tipo</th>
              <th>Origem</th>
              <th>Descrição</th>
            </tr>
          </thead>
          <tbody>
            {t.columns.map((c) => (
              <tr>
                <td>
                  <code>{c.name}</code>
                </td>
                <td>
                  <code>{c.type}</code>
                </td>
                <td class="muted">{c.source && <code>{c.source}</code>}</td>
                <td>
                  {c.description ?? ""}
                  {(t.nulls_added?.[c.name] ?? 0) > 0 && (
                    <span class="note">
                      {" "}
                      {fmtInt(t.nulls_added![c.name]!)} valor(es) inválido(s) na origem viraram nulo.
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>

<style>
  /* as notas do manifest: frases para quem lê, não dados tabulares */
  .notas {
    max-width: 44rem;
    padding-left: 1.2rem;
    font-size: 0.95rem;
  }
  .notas li + li {
    margin-top: 0.25rem;
  }
</style>
