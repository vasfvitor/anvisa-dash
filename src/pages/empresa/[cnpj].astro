---
// Uma página por empresa com produto, medida, envase de alimentos ou certificado de boas práticas na ANVISA,
// gerada no build: os produtos de cada corredor com situação e números, quem envasa ou fabrica os alimentos e os
// dispositivos médicos da empresa e para quem ela envasa (a envasadora sem produto próprio também tem página), os
// certificados de boas práticas por fábrica (quem só tem certificado, e a fábrica certificada a pedido de outra
// empresa, também têm página) e as medidas de fiscalização. HTML puro, sem a ilha: buscadores e ferramentas de
// leitura de página (inclusive as dos assistentes) leem sem rodar JavaScript.
import Base from "../../layouts/Base.astro";
import LinhaCertificado from "../../components/LinhaCertificado.astro";
import { CORREDORES, corredorPorId, rotaDo, type Corredor } from "../../corredores";
import { MARCAS_NO_TITULO, tituloAlimento } from "../../corredores/alimentos/produto";
import { validade } from "../../lib/validade";
import { empresasDoBuild } from "../../lib/estatico/dados";
import {
  CERTIFICADOS_NA_PAGINA,
  certificadosDe,
  dadosDeRemedios,
  indexavel,
  letraDe,
  resumo,
  totalProdutos,
  type Empresa,
} from "../../lib/estatico/empresas";
import { fmtCnpj, fmtData, fmtInt, fmtProcesso, fmtRegistro, marcas, plural, url } from "../../lib/format";
import { situacaoDe } from "../../lib/situacao";
import { legivel } from "../../lib/texto";

export async function getStaticPaths() {
  const empresas = await empresasDoBuild();
  return [...empresas.values()].map((e) => ({ params: { cnpj: e.cnpj }, props: { e } }));
}

interface Props {
  e: Empresa;
}
const { e } = Astro.props;
// medida sem razão social (rara) deixa a empresa sem nome: o CNPJ vira o nome
const nome = e.nome ? legivel(e.nome, "nome") : `CNPJ ${fmtCnpj(e.cnpj)}`;
const r = resumo(e);
const semProdutos = totalProdutos(e) === 0;
const alimentos = corredorPorId("alimentos");
const limpeza = corredorPorId("saneantes");
const cosmeticos = corredorPorId("cosmeticos");
const remedios = corredorPorId("medicamentos");
const dispositivos = corredorPorId("produtos_saude");
const produto = (rota: string, id: string | number) => `${rota}?p=${encodeURIComponent(String(id))}`;
const buscaEm = (c: Corredor) => `${rotaDo(c)}?${new URLSearchParams({ q: fmtCnpj(e.cnpj) }).toString()}`;
// a busca abre no corredor onde a empresa tem produto (o primeiro, na ordem das placas)
const busca = buscaEm(
  r.alimentos || semProdutos
    ? alimentos
    : r.saneantes
      ? limpeza
      : r.cosmeticos
        ? cosmeticos
        : r.medicamentos
          ? remedios
          : dispositivos,
);
// limpeza e cosméticos têm a mesma tabela (situação, tipo, validade e números); os cosméticos de uma empresa
// grande vêm cortados (COSMETICOS_POR_EMPRESA) e a busca mostra o resto
const comValidade = [
  { c: limpeza, linhas: e.saneantes, total: r.saneantes },
  { c: cosmeticos, linhas: e.cosmeticos, total: r.cosmeticos },
  { c: remedios, linhas: e.medicamentos, total: r.medicamentos },
  { c: dispositivos, linhas: e.produtosSaude, total: r.produtosSaude },
].filter((s) => s.linhas.length > 0);
// as duas pontas do envase entre empresas brasileiras; os fabricantes no exterior vão numa lista sem link
const fabricacao = [
  { titulo: "Envasa para", lista: e.envasaPara },
  { titulo: "Envasado por", lista: e.envasadoPor },
].filter((f) => f.lista.length > 0);
const temEnvase = fabricacao.length + e.exterior.length > 0;

// boas práticas: cada lista cortada em CERTIFICADOS_NA_PAGINA, vigentes antes (a ordem vem de agrupar)
const plantas = e.fabricasCertificadas.slice(0, CERTIFICADOS_NA_PAGINA);
const solicitantes = e.certificadaPara.slice(0, CERTIFICADOS_NA_PAGINA);
const semFabrica = e.certificadosSemFabrica.slice(0, CERTIFICADOS_NA_PAGINA);
const corte = (mostrados: number, total: number, genero: "a" | "o") =>
  mostrados < total
    ? `${genero === "a" ? "As" : "Os"} ${fmtInt(mostrados)} primeir${genero}s de ${fmtInt(total)}, vigentes antes.`
    : "";
// os certificados de remédios estão parados numa data antiga: a nota diz a data deles e a dos outros
const dadosRemedios = dadosDeRemedios(e);
const dadosOutros = [...certificadosDe(e), ...e.certificadaPara.flatMap((x) => x.certificados)]
  .filter((c) => c.area !== "medicamentos")
  .map((c) => c.dadosDe)
  .sort()
  .at(-1);

const produtos = [
  r.alimentos &&
    `${plural(r.alimentos, "alimento ou suplemento", "alimentos e suplementos")} (${plural(r.alimentosAtivos, "liberado")})`,
  r.saneantes &&
    `${plural(r.saneantes, "produto de limpeza", "produtos de limpeza")} (${plural(r.saneantesAtivos, "liberado")})`,
  r.cosmeticos && `${plural(r.cosmeticos, "cosmético")} (${plural(r.cosmeticosAtivos, "liberado")})`,
  r.medicamentos && `${plural(r.medicamentos, "remédio")} (${plural(r.medicamentosAtivos, "liberado")})`,
  r.produtosSaude &&
    `${plural(r.produtosSaude, "dispositivo médico", "dispositivos médicos")} (${plural(r.produtosSaudeAtivos, "liberado")})`,
].filter(Boolean);
const vigentes = plural(
  r.certificadosVigentes,
  "certificado de boas práticas vigente",
  "certificados de boas práticas vigentes",
);
const partes = [
  ...produtos,
  r.envasaPara && `envasa para ${plural(r.envasaPara, "empresa")}`,
  r.fabricadoPor && `dispositivos de ${plural(r.fabricadoPor, "fabricante")}`,
  r.certificadosVigentes && vigentes,
].filter(Boolean);
const medidas = `${plural(r.medidas, "medida")} da ANVISA`;
// a lista dos corredores, gerada: um sexto corredor não fica de fora das duas frases de "sem produto"
const osCorredores = CORREDORES.map((c) => `os ${c.nome.toLocaleLowerCase("pt-BR")}`);
const entreCorredores = `${osCorredores.slice(0, -1).join(", ")} e ${osCorredores.at(-1)}`;
const semProdutoFrase = (de: string) => `Nenhum produto ${de} entre ${entreCorredores} na lista da ANVISA.`;
// a envasadora sem produto próprio: os produtos que ela faz estão em nome das clientes
const soEnvasa = semProdutos && r.envasaPara > 0;
const envasaFrase = `envasa alimentos e suplementos para ${plural(r.envasaPara, "empresa")}`;
// quem só tem certificado de boas práticas: pedidos por ela, ou pedidos por outra empresa para a fábrica dela
const soCertifica = semProdutos && !soEnvasa && r.certificados + r.certificadaPara > 0;
const certificadosFrase = r.certificados
  ? `tem ${plural(r.certificados, "certificado de boas práticas", "certificados de boas práticas")} na ANVISA (${plural(r.certificadosVigentes, "vigente")}), por fábrica inspecionada`
  : `é fábrica com certificado de boas práticas pedido por ${plural(r.certificadaPara, "empresa")} na ANVISA`;
const comMedidas = r.medidas ? ` ${medidas} contra a empresa.` : "";
const descricao = soEnvasa
  ? `${nome} (CNPJ ${fmtCnpj(e.cnpj)}) ${envasaFrase} na ANVISA.${comMedidas} ${semProdutoFrase("em nome da empresa")}`
  : soCertifica
    ? `${nome} (CNPJ ${fmtCnpj(e.cnpj)}) ${certificadosFrase}.${comMedidas} ${semProdutoFrase("em nome da empresa")}`
    : semProdutos
      ? `${medidas} contra ${nome} (CNPJ ${fmtCnpj(e.cnpj)}). ${semProdutoFrase("da empresa")}`
      : `${produtos.join(", ").replace(/, ([^,]*)$/, " e $1")} de ${nome} (CNPJ ${fmtCnpj(e.cnpj)}) na ANVISA, com situação e números de processo.${r.envasaPara ? ` Também ${envasaFrase}.` : ""}${r.certificadosVigentes ? ` Com ${vigentes}.` : ""}`;
const resumoLinha = [`CNPJ ${fmtCnpj(e.cnpj)}`, ...partes, r.medidas > 0 && medidas].filter(Boolean).join(" · ");

const letra = letraDe(e.nome);

const canonico = new URL(Astro.url.pathname, Astro.site).href;
const organizacao = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${canonico}#empresa`,
  name: nome,
  taxID: fmtCnpj(e.cnpj),
};
---

<Base
  title={`${nome}: ${soEnvasa ? "envasa alimentos para outras empresas" : soCertifica ? "certificados de boas práticas de fabricação" : semProdutos ? "medidas da ANVISA" : "produtos na ANVISA"}`}
  description={descricao}
  noindex={!indexavel(e)}
  estruturados={[organizacao]}
  prosa
>
  <h1>{nome}</h1>
  <p class="lead">{resumoLinha}</p>
  {semProdutos && <p>{semProdutoFrase(soEnvasa || soCertifica ? "em nome desta empresa" : "desta empresa")}</p>}
  <p>
    <a href={busca}>Buscar esta empresa no contém.</a> ·{" "}
    <a href={url(`/empresas/${letra}/`)}>Outras empresas em {letra === "0-9" ? "0–9" : letra.toUpperCase()}</a>
  </p>

  {e.alimentos.length > 0 && (
    <section>
      <h2>{alimentos.nome}</h2>
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            {e.alimentos.map((p) => {
              const ms = marcas(p.marcas);
              const { titulo, subtitulo } = tituloAlimento(ms, p.nome);
              const outras = ms.length - MARCAS_NO_TITULO;
              const detalhe = [subtitulo, p.categoria && legivel(p.categoria)].filter(Boolean).join(" · ");
              return (
                <tr>
                  <td>
                    <span class="linha">
                      <a href={produto(rotaDo(alimentos), p.id)}>{titulo}</a>
                      {outras > 0 && <span class="muted">{` +${outras}`}</span>}
                    </span>
                    {detalhe && <span class="linha muted">{detalhe}</span>}
                  </td>
                  <td>
                    <span class="linha">
                      <span class={`situacao ${p.ativo ? "ok" : "off"}`} title={situacaoDe(p.ativo).dica}>
                        {situacaoDe(p.ativo).curto}
                      </span>
                    </span>
                    <span class="linha muted">{p.desde ? `${p.tipo} em ${fmtData(p.desde)}` : p.tipo}</span>
                    <span class="linha numero">Processo {fmtProcesso(p.processo)}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {comValidade.map(({ c, linhas, total }) => (
    <section>
      <h2>{c.nome}</h2>
      {linhas.length < total && (
        <p class="note">
          {`Os ${fmtInt(linhas.length)} primeiros de ${fmtInt(total)}, liberados antes. `}
          <a href={buscaEm(c)}>Ver todos na busca</a>
        </p>
      )}
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            {linhas.map((p) => {
              const v = validade(p.grupo, p.vencimento, p.ativo);
              return (
                <tr>
                  <td>
                    <a href={produto(rotaDo(c), p.id)}>{p.nome}</a>
                  </td>
                  <td>
                    <span class="linha">
                      <span class={`situacao ${p.ativo ? "ok" : "off"}`} title={situacaoDe(p.ativo).dica}>
                        {situacaoDe(p.ativo).curto}
                      </span>
                    </span>
                    <span class="linha muted">{p.tipo}</span>
                    <span class={`linha ${v.classe === "perigo" ? "perigo" : "muted"}`} title={v.dica}>
                      {v.curto}
                    </span>
                    <span class="linha numero">Processo {fmtProcesso(p.processo)}</span>
                    {p.registro && <span class="linha numero">Registro {fmtRegistro(p.registro)}</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  {temEnvase || e.fabricadoPor.length > 0 ? (
    <section>
      <h2>Fabricação</h2>
      <p>
        Quem fabrica os produtos desta empresa e para quem ela envasa, segundo o que está regularizado na ANVISA: os
        alimentos e suplementos informam a envasadora; os dispositivos médicos, o fabricante.
      </p>
      {fabricacao.map(({ titulo, lista }) => (
        <>
          <h3>{titulo}</h3>
          <div class="table-wrap">
            <table class="produtos">
              <thead>
                <tr>
                  <th>Empresa</th>
                  <th>Produtos</th>
                </tr>
              </thead>
              <tbody>
                {lista.map((x) => (
                  <tr>
                    <td>
                      <span class="linha">
                        <a href={url(`/empresa/${x.cnpj}/`)}>
                          {x.nome ? legivel(x.nome, "nome") : `CNPJ ${fmtCnpj(x.cnpj)}`}
                        </a>
                        {x.vinculo === "grupo" && (
                          <span class="muted" title="outra filial da mesma raiz de CNPJ">
                            {" · mesmo grupo"}
                          </span>
                        )}
                      </span>
                      {(x.cidade || x.pais) && (
                        <span class="linha muted">
                          {legivel([x.cidade, x.pais].filter(Boolean).join(", "), "nome")}
                        </span>
                      )}
                      <span class="linha numero">CNPJ {fmtCnpj(x.cnpj)}</span>
                    </td>
                    <td>
                      <span class="linha">
                        {plural(x.produtos, "alimento ou suplemento", "alimentos e suplementos")}
                      </span>
                      <span class="linha muted">{plural(x.produtosAtivos, "liberado")}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      {e.exterior.length > 0 && (
        <>
          <h3>Fabricantes no exterior</h3>
          <ul class="empresas">
            {e.exterior.map((f) => (
              <li>
                {legivel(f.nome, "nome")}
                {f.pais && <span class="muted">{` · ${legivel(f.pais, "nome")}`}</span>}
              </li>
            ))}
          </ul>
        </>
      )}
      {e.fabricadoPor.length > 0 && (
        <>
          <h3>Fabricantes dos dispositivos médicos</h3>
          <div class="table-wrap">
            <table class="produtos">
              <thead>
                <tr>
                  <th>Fabricante</th>
                  <th>Dispositivos</th>
                </tr>
              </thead>
              <tbody>
                {e.fabricadoPor.map((f) => (
                  <tr>
                    <td>
                      <span class="linha">
                        {f.slug ? (
                          <a
                            href={url(`/fabricante/${f.slug}/`)}
                            title="As empresas que registram dispositivos deste fabricante"
                          >
                            {legivel(f.nome, "nome")}
                          </a>
                        ) : (
                          legivel(f.nome, "nome")
                        )}
                      </span>{" "}
                      {f.pais && <span class="linha muted">{legivel(f.pais, "nome")}</span>}
                    </td>
                    <td>
                      <span class="linha">{plural(f.registros, "dispositivo médico", "dispositivos médicos")}</span>{" "}
                      <span class="linha muted">{plural(f.registrosAtivos, "liberado")}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
      <p class="note">
        {temEnvase && "Envasar para outra empresa é fabricar o produto que ela registra com a marca dela. "}
        {e.fabricadoPor.length > 0 &&
          "Nos dispositivos médicos, quem responde pelo produto no Brasil é a empresa que o registra; o fabricante pode ser outro, em outro país. "}
        {e.fabricadoPor.length > 0
          ? "Remédios, cosméticos e produtos de limpeza não informam quem fabrica."
          : "Só os alimentos e suplementos informam quem envasa."}
      </p>
    </section>
  ) : null}

  {plantas.length + solicitantes.length + semFabrica.length > 0 && (
    <section>
      <h2>Boas práticas de fabricação</h2>
      <p>
        Os certificados de boas práticas (<abbr title="Certificado de Boas Práticas de Fabricação">CBPF</abbr> e{" "}
        <abbr title="Certificado de Boas Práticas de Distribuição e Armazenagem">CBPDA</abbr>) que a ANVISA emitiu{" "}
        {plantas.length + semFabrica.length === 0
          ? "a pedido de outras empresas para a fábrica desta."
          : solicitantes.length === 0
            ? "a pedido desta empresa, por fábrica inspecionada."
            : "a pedido desta empresa, por fábrica inspecionada, e os que outras empresas pediram para a fábrica dela."}
      </p>
      {plantas.length > 0 && (
        <>
          <h3>Fábricas certificadas a pedido desta empresa</h3>
          {corte(plantas.length, e.fabricasCertificadas.length, "a") && (
            <p class="note">{corte(plantas.length, e.fabricasCertificadas.length, "a")}</p>
          )}
          <div class="table-wrap">
            <table class="produtos">
              <thead>
                <tr>
                  <th>Fábrica</th>
                  <th>Certificados</th>
                </tr>
              </thead>
              <tbody>
                {plantas.map((p) => (
                  <tr>
                    <td>
                      <span class="linha">
                        {p.comPagina && p.cnpj ? (
                          <a href={url(`/empresa/${p.cnpj}/`)}>
                            {p.nome ? legivel(p.nome, "nome") : `CNPJ ${fmtCnpj(p.cnpj)}`}
                          </a>
                        ) : p.nome ? (
                          legivel(p.nome, "nome")
                        ) : (
                          "Fábrica sem nome"
                        )}
                        {p.vinculo === "propria" && (
                          <span class="muted" title="a fábrica é a própria empresa">
                            {" · própria"}
                          </span>
                        )}
                        {p.vinculo === "grupo" && (
                          <span class="muted" title="outra filial da mesma raiz de CNPJ">
                            {" · mesmo grupo"}
                          </span>
                        )}
                      </span>{" "}
                      {p.pais && <span class="linha muted">{legivel(p.pais, "nome")}</span>}{" "}
                      {p.cnpj && <span class="linha numero">CNPJ {fmtCnpj(p.cnpj)}</span>}
                      {p.codigo && (
                        <span class="linha numero" title="o código da fábrica no exterior na ANVISA">
                          Código ANVISA {p.codigo}
                        </span>
                      )}
                    </td>
                    <td>
                      {p.certificados.map((c) => (
                        <div class="certificado">
                          <LinhaCertificado c={c} />
                        </div>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
      {solicitantes.length > 0 && (
        <>
          <h3>Certificada a pedido de</h3>
          {corte(solicitantes.length, e.certificadaPara.length, "a") && (
            <p class="note">{corte(solicitantes.length, e.certificadaPara.length, "a")}</p>
          )}
          <div class="table-wrap">
            <table class="produtos">
              <thead>
                <tr>
                  <th>Empresa</th>
                  <th>Certificados</th>
                </tr>
              </thead>
              <tbody>
                {solicitantes.map((x) => (
                  <tr>
                    <td>
                      <span class="linha">
                        <a href={url(`/empresa/${x.cnpj}/`)}>
                          {x.nome ? legivel(x.nome, "nome") : `CNPJ ${fmtCnpj(x.cnpj)}`}
                        </a>
                        {x.vinculo === "grupo" && (
                          <span class="muted" title="outra filial da mesma raiz de CNPJ">
                            {" · mesmo grupo"}
                          </span>
                        )}
                      </span>{" "}
                      <span class="linha numero">CNPJ {fmtCnpj(x.cnpj)}</span>
                    </td>
                    <td>
                      {x.certificados.map((c) => (
                        <div class="certificado">
                          <LinhaCertificado c={c} />
                        </div>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
      {semFabrica.length > 0 && (
        <>
          <h3>Certificados sem fábrica informada</h3>
          {corte(semFabrica.length, e.certificadosSemFabrica.length, "o") && (
            <p class="note">{corte(semFabrica.length, e.certificadosSemFabrica.length, "o")}</p>
          )}
          <ul class="empresas certificados">
            {semFabrica.map((c) => (
              <li>
                <LinhaCertificado c={c} />
              </li>
            ))}
          </ul>
        </>
      )}
      {dadosRemedios && (
        <p class="note">
          {`Os certificados de remédios mostram a situação em ${fmtData(dadosRemedios)}, quando a ANVISA parou de atualizar essa lista${dadosOutros ? `; os das outras áreas, a de ${fmtData(dadosOutros)}.` : "."}`}
        </p>
      )}
      <p class="note">
        O certificado diz que a ANVISA inspecionou a fábrica e aprovou como ela produz (CBPF) ou distribui e armazena
        (CBPDA); não diz se um produto está liberado. Vigente é o certificado dentro da validade na data dos dados.
      </p>
    </section>
  )}

  {e.medidas.length > 0 && (
    <section>
      <h2>Medidas da ANVISA</h2>
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Data</th>
              <th>Produto</th>
              <th>Medida</th>
            </tr>
          </thead>
          <tbody>
            {e.medidas.map((m) => (
              <tr>
                <td class="mono">{fmtData(m.data)}</td>
                <td>
                  <span class="linha">{legivel(m.produto, "nome")}</span>
                  <span class="linha muted">{corredorPorId(m.corredor).nome}</span>
                </td>
                <td>{m.acoes.join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">Uma medida diz o que a ANVISA publicou, não se o produto ainda está à venda.</p>
    </section>
  )}
</Base>
