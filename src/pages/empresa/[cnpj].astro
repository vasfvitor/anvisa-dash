---
// Uma página por empresa com produto, medida ou envase de alimentos na ANVISA, gerada no build: os produtos de
// cada corredor com situação e números, quem envasa ou fabrica os alimentos da empresa e para quem ela envasa
// (a envasadora sem produto próprio também tem página), e as medidas de fiscalização. HTML puro, sem a ilha:
// buscadores e ferramentas de leitura de página (inclusive as dos assistentes) leem sem rodar JavaScript.
import Base from "../../layouts/Base.astro";
import { CORREDORES, corredorPorId, rotaDo, type Corredor } from "../../corredores";
import { MARCAS_NO_TITULO, tituloAlimento } from "../../corredores/alimentos/produto";
import { validade } from "../../lib/validade";
import { empresasDoBuild } from "../../lib/estatico/dados";
import { indexavel, letraDe, resumo, totalProdutos, type Empresa } from "../../lib/estatico/empresas";
import { fmtCnpj, fmtData, fmtInt, fmtProcesso, fmtRegistro, marcas, plural, url } from "../../lib/format";
import { situacaoDe } from "../../lib/situacao";
import { legivel } from "../../lib/texto";

export async function getStaticPaths() {
  const empresas = await empresasDoBuild();
  return [...empresas.values()].map((e) => ({ params: { cnpj: e.cnpj }, props: { e } }));
}

interface Props {
  e: Empresa;
}
const { e } = Astro.props;
// medida sem razão social (rara) deixa a empresa sem nome: o CNPJ vira o nome
const nome = e.nome ? legivel(e.nome, "nome") : `CNPJ ${fmtCnpj(e.cnpj)}`;
const r = resumo(e);
const semProdutos = totalProdutos(e) === 0;
const alimentos = corredorPorId("alimentos");
const limpeza = corredorPorId("saneantes");
const cosmeticos = corredorPorId("cosmeticos");
const remedios = corredorPorId("medicamentos");
const dispositivos = corredorPorId("produtos_saude");
const produto = (rota: string, id: string | number) => `${rota}?p=${encodeURIComponent(String(id))}`;
const buscaEm = (c: Corredor) => `${rotaDo(c)}?${new URLSearchParams({ q: fmtCnpj(e.cnpj) }).toString()}`;
// a busca abre no corredor onde a empresa tem produto (o primeiro, na ordem das placas)
const busca = buscaEm(
  r.alimentos || semProdutos
    ? alimentos
    : r.saneantes
      ? limpeza
      : r.cosmeticos
        ? cosmeticos
        : r.medicamentos
          ? remedios
          : dispositivos,
);
// limpeza e cosméticos têm a mesma tabela (situação, tipo, validade e números); os cosméticos de uma empresa
// grande vêm cortados (COSMETICOS_POR_EMPRESA) e a busca mostra o resto
const comValidade = [
  { c: limpeza, linhas: e.saneantes, total: r.saneantes },
  { c: cosmeticos, linhas: e.cosmeticos, total: r.cosmeticos },
  { c: remedios, linhas: e.medicamentos, total: r.medicamentos },
  { c: dispositivos, linhas: e.produtosSaude, total: r.produtosSaude },
].filter((s) => s.linhas.length > 0);
// as duas pontas do envase entre empresas brasileiras; os fabricantes no exterior vão numa lista sem link
const fabricacao = [
  { titulo: "Envasa para", lista: e.envasaPara },
  { titulo: "Envasado por", lista: e.envasadoPor },
].filter((f) => f.lista.length > 0);

const produtos = [
  r.alimentos &&
    `${plural(r.alimentos, "alimento ou suplemento", "alimentos e suplementos")} (${plural(r.alimentosAtivos, "liberado")})`,
  r.saneantes &&
    `${plural(r.saneantes, "produto de limpeza", "produtos de limpeza")} (${plural(r.saneantesAtivos, "liberado")})`,
  r.cosmeticos && `${plural(r.cosmeticos, "cosmético")} (${plural(r.cosmeticosAtivos, "liberado")})`,
  r.medicamentos && `${plural(r.medicamentos, "remédio")} (${plural(r.medicamentosAtivos, "liberado")})`,
  r.produtosSaude &&
    `${plural(r.produtosSaude, "dispositivo médico", "dispositivos médicos")} (${plural(r.produtosSaudeAtivos, "liberado")})`,
].filter(Boolean);
const partes = [...produtos, r.envasaPara && `envasa para ${plural(r.envasaPara, "empresa")}`].filter(Boolean);
const medidas = `${plural(r.medidas, "medida")} da ANVISA`;
// a lista dos corredores, gerada: um sexto corredor não fica de fora das duas frases de "sem produto"
const osCorredores = CORREDORES.map((c) => `os ${c.nome.toLocaleLowerCase("pt-BR")}`);
const entreCorredores = `${osCorredores.slice(0, -1).join(", ")} e ${osCorredores.at(-1)}`;
const semProdutoFrase = (de: string) => `Nenhum produto ${de} entre ${entreCorredores} na lista da ANVISA.`;
// a envasadora sem produto próprio: os produtos que ela faz estão em nome das clientes
const soEnvasa = semProdutos && r.envasaPara > 0;
const envasaFrase = `envasa alimentos e suplementos para ${plural(r.envasaPara, "empresa")}`;
const descricao = soEnvasa
  ? `${nome} (CNPJ ${fmtCnpj(e.cnpj)}) ${envasaFrase} na ANVISA.${r.medidas ? ` ${medidas} contra a empresa.` : ""} ${semProdutoFrase("em nome da empresa")}`
  : semProdutos
    ? `${medidas} contra ${nome} (CNPJ ${fmtCnpj(e.cnpj)}). ${semProdutoFrase("da empresa")}`
    : `${produtos.join(", ").replace(/, ([^,]*)$/, " e $1")} de ${nome} (CNPJ ${fmtCnpj(e.cnpj)}) na ANVISA, com situação e números de processo.${r.envasaPara ? ` Também ${envasaFrase}.` : ""}`;
const resumoLinha = [`CNPJ ${fmtCnpj(e.cnpj)}`, ...partes, r.medidas > 0 && medidas].filter(Boolean).join(" · ");

const letra = letraDe(e.nome);

const canonico = new URL(Astro.url.pathname, Astro.site).href;
const organizacao = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${canonico}#empresa`,
  name: nome,
  taxID: fmtCnpj(e.cnpj),
};
---

<Base
  title={`${nome}: ${soEnvasa ? "envasa alimentos para outras empresas" : semProdutos ? "medidas da ANVISA" : "produtos na ANVISA"}`}
  description={descricao}
  noindex={!indexavel(e)}
  estruturados={[organizacao]}
>
  <h1>{nome}</h1>
  <p class="lead">{resumoLinha}</p>
  {semProdutos && <p>{semProdutoFrase(soEnvasa ? "em nome desta empresa" : "desta empresa")}</p>}
  <p>
    <a href={busca}>Buscar esta empresa no contém.</a> ·{" "}
    <a href={url(`/empresas/${letra}/`)}>Outras empresas em {letra === "0-9" ? "0–9" : letra.toUpperCase()}</a>
  </p>

  {e.alimentos.length > 0 && (
    <section>
      <h2>{alimentos.nome}</h2>
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            {e.alimentos.map((p) => {
              const ms = marcas(p.marcas);
              const { titulo, subtitulo } = tituloAlimento(ms, p.nome);
              const outras = ms.length - MARCAS_NO_TITULO;
              const detalhe = [subtitulo, p.categoria && legivel(p.categoria)].filter(Boolean).join(" · ");
              return (
                <tr>
                  <td>
                    <span class="linha">
                      <a href={produto(rotaDo(alimentos), p.id)}>{titulo}</a>
                      {outras > 0 && <span class="muted">{` +${outras}`}</span>}
                    </span>
                    {detalhe && <span class="linha muted">{detalhe}</span>}
                  </td>
                  <td>
                    <span class="linha">
                      <span class={`situacao ${p.ativo ? "ok" : "off"}`} title={situacaoDe(p.ativo).dica}>
                        {situacaoDe(p.ativo).curto}
                      </span>
                    </span>
                    <span class="linha muted">{p.desde ? `${p.tipo} em ${fmtData(p.desde)}` : p.tipo}</span>
                    <span class="linha numero">Processo {fmtProcesso(p.processo)}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {comValidade.map(({ c, linhas, total }) => (
    <section>
      <h2>{c.nome}</h2>
      {linhas.length < total && (
        <p class="note">
          {`Os ${fmtInt(linhas.length)} primeiros de ${fmtInt(total)}, liberados antes. `}
          <a href={buscaEm(c)}>Ver todos na busca</a>
        </p>
      )}
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Situação</th>
            </tr>
          </thead>
          <tbody>
            {linhas.map((p) => {
              const v = validade(p.grupo, p.vencimento, p.ativo);
              return (
                <tr>
                  <td>
                    <a href={produto(rotaDo(c), p.id)}>{p.nome}</a>
                  </td>
                  <td>
                    <span class="linha">
                      <span class={`situacao ${p.ativo ? "ok" : "off"}`} title={situacaoDe(p.ativo).dica}>
                        {situacaoDe(p.ativo).curto}
                      </span>
                    </span>
                    <span class="linha muted">{p.tipo}</span>
                    <span class={`linha ${v.classe === "perigo" ? "perigo" : "muted"}`} title={v.dica}>
                      {v.curto}
                    </span>
                    <span class="linha numero">Processo {fmtProcesso(p.processo)}</span>
                    {p.registro && <span class="linha numero">Registro {fmtRegistro(p.registro)}</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  {fabricacao.length + e.exterior.length > 0 && (
    <section>
      <h2>Fabricação</h2>
      <p>
        Quem envasa ou fabrica os alimentos e suplementos desta empresa, e para quem ela envasa, segundo as
        apresentações regularizadas na ANVISA.
      </p>
      {fabricacao.map(({ titulo, lista }) => (
        <>
          <h3>{titulo}</h3>
          <div class="table-wrap">
            <table class="produtos">
              <thead>
                <tr>
                  <th>Empresa</th>
                  <th>Produtos</th>
                </tr>
              </thead>
              <tbody>
                {lista.map((x) => (
                  <tr>
                    <td>
                      <span class="linha">
                        <a href={url(`/empresa/${x.cnpj}/`)}>
                          {x.nome ? legivel(x.nome, "nome") : `CNPJ ${fmtCnpj(x.cnpj)}`}
                        </a>
                        {x.vinculo === "grupo" && (
                          <span class="muted" title="outra filial da mesma raiz de CNPJ">
                            {" · mesmo grupo"}
                          </span>
                        )}
                      </span>
                      {(x.cidade || x.pais) && (
                        <span class="linha muted">
                          {legivel([x.cidade, x.pais].filter(Boolean).join(", "), "nome")}
                        </span>
                      )}
                      <span class="linha numero">CNPJ {fmtCnpj(x.cnpj)}</span>
                    </td>
                    <td>
                      <span class="linha">
                        {plural(x.produtos, "alimento ou suplemento", "alimentos e suplementos")}
                      </span>
                      <span class="linha muted">{plural(x.produtosAtivos, "liberado")}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      {e.exterior.length > 0 && (
        <>
          <h3>Fabricantes no exterior</h3>
          <ul class="empresas">
            {e.exterior.map((f) => (
              <li>
                {legivel(f.nome, "nome")}
                {f.pais && <span class="muted">{` · ${legivel(f.pais, "nome")}`}</span>}
              </li>
            ))}
          </ul>
        </>
      )}
      <p class="note">
        Envasar para outra empresa é fabricar o produto que ela registra com a marca dela. Só os alimentos e suplementos
        informam quem envasa.
      </p>
    </section>
  )}

  {e.medidas.length > 0 && (
    <section>
      <h2>Medidas da ANVISA</h2>
      <div class="table-wrap">
        <table class="produtos">
          <thead>
            <tr>
              <th>Data</th>
              <th>Produto</th>
              <th>Medida</th>
            </tr>
          </thead>
          <tbody>
            {e.medidas.map((m) => (
              <tr>
                <td class="mono">{fmtData(m.data)}</td>
                <td>
                  <span class="linha">{legivel(m.produto, "nome")}</span>
                  <span class="linha muted">{corredorPorId(m.corredor).nome}</span>
                </td>
                <td>{m.acoes.join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">Uma medida diz o que a ANVISA publicou, não se o produto ainda está à venda.</p>
    </section>
  )}
</Base>

<style>
  /* prosa em largura de leitura */
  p {
    max-width: 44rem;
  }
  /* números nunca quebram no meio (a fonte mono vem de .numero em base.css) */
  .numero {
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .perigo {
    color: var(--off);
  }
  .produtos td:last-child {
    width: 16rem;
  }
  /* no celular cada produto vira um bloco: o nome em cima, a situação e os números embaixo */
  @media (max-width: 34rem) {
    .produtos thead {
      display: none;
    }
    .produtos tr,
    .produtos td {
      display: block;
    }
    .produtos td {
      border-bottom: 0;
      padding: 0.15rem 0;
    }
    .produtos tr {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line);
    }
    .produtos td:last-child {
      width: auto;
    }
  }
</style>
