---
// A abertura (hero) de um corredor. A página do corredor mostra a sua e guarda as dos outros em <template>:
// conteúdo inerte (fora da página para buscadores e leitores de tela) que a troca de corredor clona.
import type { Corredor } from "../corredores";
import Icone from "./Icone.astro";

interface Props {
  c: Corredor;
}
const { c } = Astro.props;
---

<section class="hero" data-hero={c.id}>
  <div class="hero-deco" aria-hidden="true">
    {c.deco.map((nome, i) => (
      <span class={`deco deco-${i}`}>
        <Icone nome={nome} />
      </span>
    ))}
  </div>
  <h1>
    {c.hero.linha1.antes}
    <em>{c.hero.linha1.destaque}</em>
    {c.hero.linha1.depois}
    <br />
    {c.hero.linha2.antes}
    <span class="sublinhado">
      {c.hero.linha2.destaque}
      <svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M2 8c40-6 90-7 196-2" />
      </svg>
    </span>
    {c.hero.linha2.depois}
  </h1>
  <p class="lead">{c.hero.lead}</p>
</section>
