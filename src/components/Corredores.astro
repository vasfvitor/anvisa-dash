---
// As placas dos corredores no cabeçalho. São links de verdade (funcionam sem JavaScript e nas
// páginas de dados e sobre); na busca, a ilha intercepta o clique e troca de corredor sem recarregar.
import { CORREDORES, rotaDo } from "../corredores";
import Icone from "./Icone.astro";

interface Props {
  atual?: string;
}
const { atual } = Astro.props;
---

<nav class="corredores" aria-label="Corredores">
  {CORREDORES.map((c) => (
    <a
      class="placa"
      href={rotaDo(c)}
      data-corredor-link={c.id}
      data-placa={c.id}
      aria-current={atual === c.id ? "page" : undefined}
      title={`${c.nome}${c.tecnico ? ` (na ANVISA, ${c.tecnico})` : ""}`}
    >
      <span class="placa-num">{c.numero}</span>
      <Icone nome={c.icone} />
      <span class="placa-nome">
        <span class="longo">{c.nome}</span>
        <span class="curto">{c.curto}</span>
      </span>
      <span class="placa-tec" aria-hidden="true">
        <strong>{c.nome}</strong>
        {c.tecnico && (
          <>
            {" · na ANVISA: "}
            <em>{c.tecnico}</em>
          </>
        )}
      </span>
    </a>
  ))}
</nav>
<script is:inline>
  // nas telas médias e no celular as placas são uma faixa rolável: a atual entra à vista antes da ilha subir
  {
    const nav = document.querySelector(".corredores");
    const atual = nav && nav.querySelector("[aria-current]");
    if (atual && nav.scrollWidth > nav.clientWidth) {
      atual.scrollIntoView({ block: "nearest", inline: "center", behavior: "instant" });
    }
  }
</script>
