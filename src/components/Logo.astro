---
// Logotipo: "contém." com o acento do é desenhado como uma cápsula inclinada.
import { url } from "../lib/format";
import { NOME } from "../lib/marca";
---

<!-- o nome vem do texto para leitor de tela, não de aria-label: as letras desenhadas não batem com um rótulo -->
<a class="logo" href={url("/")}>
  <span class="sr-only">{NOME}, página inicial</span>
  <span aria-hidden="true">
    cont
    <span class="logo-e">
      e<span class="logo-capsula"></span>
    </span>
    m<span class="logo-ponto">.</span>
  </span>
</a>
